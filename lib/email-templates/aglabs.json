{
  "sourceLabel": "Base de campanha adaptada do modelo institucional fornecido pela AG LABS",
  "importedOn": "2026-10-18",
  "sourceFiles": [
    "lib/email-templates/aglabs.json"
  ],
  "variables": [
    "preheader",
    "categoria",
    "titulo",
    "mensagem",
    "texto_acao",
    "url_acao",
    "assinatura",
    "rodape"
  ],
  "templates": [
    {
      "id": "aglabs-base",
      "subject": "Modelo-base AG LABS",
      "html": "<!doctype html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>{{titulo}} | AG LABS</title>\n</head>\n<body style=\"margin:0;padding:0;background:#f2f5f9;color:#253149;font-family:Arial,Helvetica,sans-serif;\">\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;\">{{preheader}}</div>\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"background:#f2f5f9;\">\n    <tr><td align=\"center\" style=\"padding:36px 16px 44px;\">\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"max-width:600px;\">\n        <tr><td style=\"padding:0 0 18px 4px;font-size:12px;letter-spacing:2px;font-weight:700;color:#526584;\">AG LABS <span style=\"color:#9aa7ba;\">/</span> {{categoria}}</td></tr>\n        <tr><td style=\"background:#ffffff;border:1px solid #e1e7ef;border-radius:16px;overflow:hidden;\">\n          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\">\n            <tr><td style=\"background:#0d1b34;padding:24px 34px;\">\n              <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n                <td style=\"vertical-align:middle;padding-right:12px;\"><img src=\"https://aglabs.ia.br/android-chrome-512x512.png\" width=\"40\" height=\"40\" alt=\"AG\" style=\"display:block;width:40px;height:40px;border:0;\"></td>\n                <td style=\"vertical-align:middle;font-size:25px;line-height:1.2;font-weight:700;letter-spacing:1px;color:#ffffff;\">LABS</td>\n              </tr></table>\n            </td></tr>\n            <tr><td style=\"padding:36px 34px;\"><p style=\"margin:0 0 12px;font-size:12px;font-weight:700;letter-spacing:1.3px;color:#1759af;\">{{categoria}}</p><h1 style=\"margin:0 0 24px;font-size:28px;line-height:1.25;color:#14243f;\">{{titulo}}</h1><div style=\"margin:0 0 22px;font-size:16px;line-height:1.65;color:#253149;\">{{mensagem}}</div><!-- CTA_START --><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:24px 0;\"><tr><td style=\"background:#1865ca;border-radius:8px;\"><a href=\"{{url_acao}}\" style=\"display:inline-block;padding:14px 21px;font-size:15px;line-height:1.4;font-weight:700;color:#ffffff;text-decoration:none;\">{{texto_acao}}</a></td></tr></table><!-- CTA_END --><p style=\"margin:24px 0 0;font-size:15px;line-height:1.6;color:#14243f;\">{{assinatura}}</p></td></tr>\n          </table>\n        </td></tr>\n        <tr><td align=\"center\" style=\"padding:20px 8px 0;font-size:12px;line-height:1.6;color:#718096;\">{{rodape}}</td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>",
      "text": "{{titulo}}\n\n{{mensagem}}\n\n<!-- CTA_START -->{{texto_acao}}\n{{url_acao}}<!-- CTA_END -->\n\n{{assinatura}}\n\n{{rodape}}\n\nAG LABS",
      "previewData": {
        "preheader": "Prévia do padrão visual. O conteúdo será escrito para cada campanha.",
        "categoria": "SUA CAMPANHA",
        "titulo": "Título da sua mensagem",
        "mensagem": "O texto preparado por você ou pelo agente entra aqui.\n\nPersonalize o contexto, o objetivo e o próximo passo para cada pessoa. Este conteúdo apenas demonstra o espaço da mensagem.",
        "texto_acao": "Ação opcional",
        "url_acao": "https://example.invalid/acao",
        "assinatura": "Sua assinatura\nRelacionamento",
        "rodape": "Contexto do contato e informações de rodapé da campanha."
      }
    }
  ]
}

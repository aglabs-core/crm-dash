# supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Servidor somente: retorno Brevo. Nunca use prefixo NEXT_PUBLIC_ nestes valores.
SUPABASE_SERVICE_ROLE_KEY=""
BREVO_WEBHOOK_TOKEN=""
BREVO_WEBHOOK_CONNECTION_ID=""

# Servidor somente: registro único de e-mails (docs/email-ledger.md).
RESEND_WEBHOOK_SECRET=""
RESEND_API_KEY=""
ACCOUNT_EVENTS_TOKEN=""

# Servidor somente: servidor MCP (docs/mcp.md). Entradas nome:token:escopos separadas por ';'.
CRM_MCP_TOKENS=""
# Opcional: usuário das escritas do MCP; sem ela, o único registro de admin_users.
CRM_OWNER_USER_ID=""

# Server-only administrative aggregates; never NEXT_PUBLIC_.
APP_METRICS_SOURCES=[]
APP_METRICS_SOURCES_EXTRA=[]
